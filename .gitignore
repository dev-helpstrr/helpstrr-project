# create .gitignore
@"
# Node / PHP / env
.env
env.dev
env.uat
env.prod
.env.local
.env.*.local

# editor / OS
.vscode/
.idea/
*.log
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# =========================================================
# Environment & Security
# =========================================================
.env
.env.*
!.env.example
.vagrant
Vagrantfile

# =========================================================
# Logs & Runtime
# =========================================================
*.log
php_errors.log

writable/*
!writable/index.html
!writable/cache/index.html
!writable/logs/index.html
!writable/session/index.html
!writable/uploads/index.html
!writable/debugbar/.gitkeep

# =========================================================
# Dependencies
# =========================================================
vendor/
node_modules/

# =========================================================
# Build / Coverage / Temp
# =========================================================
dist/
build/
coverage/
.nyc_output/
results/
phpunit*.xml
.phpunit.*.cache
/tests/coverage*

# =========================================================
# Composer / PHPUnit
# =========================================================
phpunit

# =========================================================
# IDE & Editor Settings
# =========================================================
# JetBrains
.idea/
*.iml

# NetBeans
nbproject/
nbbuild/
dist/
nbdist/
nbactions.xml
nb-configuration.xml
.nb-gradle/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
.phpintel

# Visual Studio Code
.vscode/

# Vim / Other editors
*.swp
*.swo

# =========================================================
# Frontend (Optional)
# =========================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# =========================================================
# Framework Specific
# =========================================================
public/hot
public/storage
/api/
_modules/*

# =========================================================
# SonarQube
# =========================================================
.scannerwork/
sonar-report.*
